{
  "name": "zotero-custom-columns",
  "version": "1.1.0",
  "description": "Zotero plugin: custom item-list columns (checkbox, rating, link, text, options) with color themes",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/anurag/zotero-custom-columns",
  "scripts": {
    "build": "node scripts/check.mjs && node scripts/build.mjs",
